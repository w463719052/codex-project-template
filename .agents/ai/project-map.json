{
  "budgets": {
    "max_expansion_rounds": 2,
    "max_initial_bytes": 90000,
    "max_initial_files": 10
  },
  "context_routes": [
    {
      "expand_when": [
        "A referenced generated path, consumer, or verification source is outside the initial pack.",
        "The approved scope changes after new evidence is found."
      ],
      "id": "workflow-upgrade",
      "initial_paths": [
        "AGENTS.md",
        "initialize-codex-project/SKILL.md",
        "initialize-codex-project/references/engineering-standards/catalog.json",
        "initialize-codex-project/references/engineering-standards/BASELINE.md",
        "initialize-codex-project/assets/project-template/AGENTS.md.template",
        "initialize-codex-project/assets/project-template/docs/CODEX_WORKFLOW.md",
        "initialize-codex-project/assets/project-template/docs/CODING_STANDARDS.md.template"
      ],
      "module_ids": ["initializer", "template-assets"],
      "task_types": ["workflow-upgrade", "template-change"]
    },
    {
      "expand_when": [
        "A script contract, language-profile selection rule, or generated target mapping changes."
      ],
      "id": "tooling-change",
      "initial_paths": [
        "initialize-codex-project/scripts/render_template.py",
        "initialize-codex-project/scripts/analyze_ab_study.py",
        "initialize-codex-project/scripts/select_language_profiles.py",
        "initialize-codex-project/scripts/validate_templates.py",
        "tests/test_language_profile_selection.py",
        "tests/test_render_template.py"
      ],
      "module_ids": ["tooling", "tests-ci"],
      "task_types": ["tooling", "performance"]
    },
    {
      "expand_when": ["Documentation changes alter a generated contract or command."],
      "id": "documentation",
      "initial_paths": ["README.md", "CHANGELOG.md", "AGENTS.md"],
      "module_ids": ["governance"],
      "task_types": ["documentation"]
    }
  ],
  "documentation_gaps": [],
  "excluded_paths": [
    ".git/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.DS_Store"
  ],
  "modules": [
    {
      "authority_docs": ["AGENTS.md", "README.md"],
      "consumers": ["initializer", "template-assets", "tooling", "tests-ci"],
      "dependencies": [],
      "entrypoints": ["AGENTS.md", "README.md"],
      "generated_paths": [],
      "id": "governance",
      "paths": [
        "AGENTS.md",
        "README.md",
        "CHANGELOG.md",
        ".editorconfig",
        ".gitignore",
        ".agents/ai/**"
      ],
      "public_contracts": ["README.md", "CHANGELOG.md"],
      "responsibility": "Repository-wide authority, operator documentation, version history, and text-file conventions.",
      "tests": []
    },
    {
      "authority_docs": ["AGENTS.md", "initialize-codex-project/SKILL.md"],
      "consumers": ["template-assets", "tooling"],
      "dependencies": ["governance"],
      "entrypoints": [
        "initialize-codex-project/SKILL.md",
        "initialize-codex-project/agents/openai.yaml"
      ],
      "generated_paths": [],
      "id": "initializer",
      "paths": [
        "initialize-codex-project/SKILL.md",
        "initialize-codex-project/VERSION",
        "initialize-codex-project/agents/**",
        "initialize-codex-project/examples/**",
        "initialize-codex-project/references/**"
      ],
      "public_contracts": [
        "initialize-codex-project/SKILL.md",
        "initialize-codex-project/agents/openai.yaml",
        "initialize-codex-project/examples/context.example.json",
        "initialize-codex-project/references/engineering-standards/catalog.json"
      ],
      "responsibility": "Initializer workflow, language engineering profiles, discovery contract, invocation metadata, template version, and example context.",
      "tests": ["tests/test_render_template.py"]
    },
    {
      "authority_docs": ["AGENTS.md", "initialize-codex-project/SKILL.md"],
      "consumers": ["initializer", "tooling", "tests-ci"],
      "dependencies": ["governance", "initializer"],
      "entrypoints": [
        "initialize-codex-project/assets/project-template/AGENTS.md.template",
        "initialize-codex-project/assets/project-template/docs/CODEX_WORKFLOW.md"
      ],
      "generated_paths": ["docs/CODEX_TEMPLATE_STATE.json"],
      "id": "template-assets",
      "paths": ["initialize-codex-project/assets/project-template/**"],
      "public_contracts": [
        "initialize-codex-project/assets/project-template/AGENTS.md.template",
        "initialize-codex-project/assets/project-template/docs/CODEX_WORKFLOW.md",
        "initialize-codex-project/assets/project-template/docs/CODING_RULES_LOG.md.template",
        "initialize-codex-project/assets/project-template/docs/CODING_STANDARDS.md.template",
        "initialize-codex-project/assets/project-template/docs/VERIFICATION.md.template"
      ],
      "responsibility": "Files rendered into target repositories, including project guidance, documentation, and baseline skills.",
      "tests": ["tests/test_render_template.py"]
    },
    {
      "authority_docs": ["AGENTS.md", "initialize-codex-project/SKILL.md"],
      "consumers": ["initializer", "tests-ci"],
      "dependencies": ["initializer", "template-assets"],
      "entrypoints": [
        "initialize-codex-project/scripts/render_template.py",
        "initialize-codex-project/scripts/select_language_profiles.py",
        "initialize-codex-project/scripts/validate_templates.py"
      ],
      "generated_paths": ["docs/CODEX_TEMPLATE_STATE.json"],
      "id": "tooling",
      "paths": ["initialize-codex-project/scripts/**"],
      "public_contracts": [
        "initialize-codex-project/scripts/render_template.py",
        "initialize-codex-project/scripts/analyze_ab_study.py",
        "initialize-codex-project/scripts/select_language_profiles.py"
      ],
      "responsibility": "Dependency-free rendering, language-profile selection, validation, and routing benchmark tools.",
      "tests": ["tests/test_render_template.py", "tests/test_ab_study.py"]
    },
    {
      "authority_docs": ["AGENTS.md"],
      "consumers": [],
      "dependencies": ["initializer", "template-assets", "tooling"],
      "entrypoints": [
        "tests/test_language_profile_selection.py",
        "tests/test_ab_study.py",
        "tests/test_render_template.py",
        ".github/workflows/validate.yml"
      ],
      "generated_paths": [],
      "id": "tests-ci",
      "paths": [
        "tests/**",
        ".github/workflows/**",
        "initialize-codex-project/benchmarks/**"
      ],
      "public_contracts": [".github/workflows/validate.yml"],
      "responsibility": "Regression, language-selection, security, deterministic routing, benchmark fixtures, and repository CI validation.",
      "tests": [
        "tests/test_ab_study.py",
        "tests/test_language_profile_selection.py",
        "tests/test_render_template.py"
      ]
    }
  ],
  "project_name": "Codex Project Template",
  "schema_version": 1
}
