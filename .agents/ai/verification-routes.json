{
  "commands": [
    {
      "command": "python3 -B initialize-codex-project/scripts/validate_templates.py",
      "evidence": "AGENTS.md#Verification",
      "id": "template-validator",
      "kind": "static",
      "mutates": false
    },
    {
      "command": "python3 -B -m unittest discover -s tests -v",
      "evidence": "AGENTS.md#Verification",
      "id": "unit-tests",
      "kind": "test",
      "mutates": false
    },
    {
      "command": "python3 -B initialize-codex-project/scripts/benchmark_routing.py",
      "evidence": "AGENTS.md#Verification",
      "id": "routing-benchmark",
      "kind": "static",
      "mutates": false
    },
    {
      "command": "git diff --check",
      "evidence": "AGENTS.md#Verification",
      "id": "diff-check",
      "kind": "diff",
      "mutates": false
    }
  ],
  "documentation_gaps": [],
  "fallback_check_ids": ["template-validator", "unit-tests", "diff-check"],
  "routes": [
    {
      "consumer_check_ids": ["unit-tests"],
      "escalate_when": [
        "A generated contract, default output, authority rule, or language profile changes."
      ],
      "focused_check_ids": ["template-validator"],
      "id": "template-assets",
      "path_patterns": [
        "initialize-codex-project/assets/project-template/**",
        "initialize-codex-project/SKILL.md",
        "initialize-codex-project/examples/**",
        "initialize-codex-project/references/**"
      ],
      "required_build_ids": ["routing-benchmark", "diff-check"]
    },
    {
      "consumer_check_ids": ["template-validator"],
      "escalate_when": [
        "Rendering, collision, path safety, context schema, language selection, or state manifest behavior changes."
      ],
      "focused_check_ids": ["unit-tests"],
      "id": "tooling",
      "path_patterns": [
        "initialize-codex-project/scripts/**",
        "initialize-codex-project/assets/project-template/skills/**"
      ],
      "required_build_ids": ["routing-benchmark", "diff-check"]
    },
    {
      "consumer_check_ids": ["template-validator"],
      "escalate_when": ["A fixture, expected route, or CI command changes."],
      "focused_check_ids": ["unit-tests", "routing-benchmark"],
      "id": "tests-and-benchmarks",
      "path_patterns": [
        "tests/**",
        "initialize-codex-project/benchmarks/**",
        ".github/workflows/**"
      ],
      "required_build_ids": ["diff-check"]
    },
    {
      "consumer_check_ids": [],
      "escalate_when": ["Operator instructions, template version, or public usage changes."],
      "focused_check_ids": ["template-validator"],
      "id": "governance-docs",
      "path_patterns": ["AGENTS.md", "README.md", "CHANGELOG.md", ".agents/ai/**"],
      "required_build_ids": ["routing-benchmark", "diff-check"]
    }
  ],
  "schema_version": 1
}
